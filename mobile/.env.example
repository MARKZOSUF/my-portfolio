# StudyForge AI - mobile development template
# Copy to mobile/.env. EXPO_PUBLIC_* values are embedded in the app bundle and
# are therefore PUBLIC. Never put an AI key, database password, storage secret,
# Google client secret, Apple private key or signing password here.

# Android emulator loopback is allowed ONLY in development/debug builds.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_APP_ENV=development

EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_APPLE_CLIENT_ID=
EXPO_PUBLIC_SENTRY_DSN=

# Google sign-in. These client IDs are public by design: the app sends the
# resulting ID token to POST /api/v1/auth/google, and the backend verifies the
# signature, issuer, audience and expiry against Google's JWKS.
# Leave every ID blank to keep the Google button hidden.
#
#   EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID - Android OAuth client (package name +
#     SHA-1 of the signing key; the debug SHA-1 comes from
#     `scripts/android-debug-sha1.sh`).
#   EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID - required for the ID-token audience on
#     Android; also used by Expo Go.
