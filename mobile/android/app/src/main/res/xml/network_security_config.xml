<?xml version="1.0" encoding="utf-8"?>
<!-- Release policy: TLS only. Cleartext HTTP is not permitted anywhere. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
