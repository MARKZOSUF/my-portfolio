<?xml version="1.0" encoding="utf-8"?>
<!--
  Generated by the expo-secure-store config plugin.
  Referenced from AndroidManifest.xml as android:fullBackupContent.
  Used on Android 11 (API 30) and below.

  SecureStore values are encrypted with a hardware-backed key that never
  leaves the original device, so a restored backup could only ever contain
  undecryptable ciphertext. Excluding the store keeps restores clean.
-->
<full-backup-content>
  <exclude domain="sharedpref" path="SecureStore" />
</full-backup-content>
