# StudyForge AI - mobile PRODUCTION template
# Copy to mobile/.env.production. All values here ship inside the APK/AAB.
#
# The app refuses to start a release build unless EXPO_PUBLIC_API_URL is a
# public HTTPS URL. localhost, 127.0.0.1, 10.0.2.2 and private LAN ranges are
# rejected with a clear configuration error.

EXPO_PUBLIC_API_URL=https://api.your-domain.com/api/v1
EXPO_PUBLIC_APP_ENV=production

EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
EXPO_PUBLIC_APPLE_CLIENT_ID=com.studyforge.ainotes.signin
EXPO_PUBLIC_SENTRY_DSN=
