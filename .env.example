# Copy to .env. Placeholders only; never commit .env. See docs/CONFIGURATION.md.
FLASK_ENV=development

# --- Single external AI key architecture ---
AI_PROVIDER=openai
AI_API_KEY=your-single-provider-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
AI_FEATURES_ENABLED=true
AI_CONNECT_TIMEOUT=10
AI_READ_TIMEOUT=90
AI_MAX_RETRIES=2
MAX_OUTPUT_TOKENS=6000

# --- Local secrets (not external API keys) ---
SECRET_KEY=replace-with-a-long-random-session-secret

# --- Database / jobs ---
DATABASE_URL=sqlite:///instance/studyresearch.db
# Required when deploying with docker-compose (Postgres):
POSTGRES_PASSWORD=choose-a-strong-database-password
JOB_BACKEND=thread
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=memory://
RESEARCH_JOB_TIMEOUT=900
STUCK_SESSION_MINUTES=30

# --- Security ---
COOKIE_SECURE=false
MALWARE_SCANNER=noop
CLAMSCAN_PATH=clamscan

# --- Limits ---
FREE_DAILY_RESEARCH_LIMIT=5
MAX_UPLOAD_MB=20
MAX_ARCHIVE_FILES=1000
MAX_ARCHIVE_EXPANDED_MB=80
MAX_DOCUMENT_PAGES=250
MAX_DOCUMENT_CHARS=500000
DOCUMENT_PROCESS_TIMEOUT=30
MAX_SOURCES=10
SOURCE_MAX_MB=8
SOURCE_MAX_PDF_PAGES=40
SOURCE_FETCH_TIMEOUT=20
SOURCE_REDIRECT_LIMIT=3
CHAT_HISTORY_LIMIT=12
CHAT_MESSAGE_MAX=1000
