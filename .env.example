# StudyForge AI - root environment template (docker-compose / local stack)
#
# This file exists so `python scripts/validate_project.py` and a plain
# `docker compose up` both work from a fresh clone. It carries only the values
# docker-compose.yml interpolates. The full backend surface lives in
# backend/.env.example, and the app-side surface in mobile/.env.example.
#
# Copy to .env and edit. NEVER commit the real .env.

# ---------------------------------------------------------------- postgres
POSTGRES_USER=studyforge
POSTGRES_PASSWORD=studyforge
POSTGRES_DB=studyforge
POSTGRES_PORT=5432

# ---------------------------------------------------------------- redis
REDIS_PORT=6379

# ---------------------------------------------------------------- api
APP_ENV=development
DEBUG=true
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://studyforge:studyforge@postgres:5432/studyforge
REDIS_URL=redis://redis:6379/0

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME
DATA_ENCRYPTION_KEY=CHANGE_ME

# ---------------------------------------------------------------- ai provider
AI_PROVIDER=development
AI_API_KEY=CHANGE_ME
