# StudyForge AI - Railway service variables template
# Paste these into Railway > your service > Variables. Values shown are
# placeholders only. Railway injects DATABASE_URL and REDIS_URL automatically
# when you attach the Postgres and Redis plugins.

APP_ENV=production
DEBUG=false
PUBLIC_APP_URL=https://app.your-domain.com
PUBLIC_API_URL=https://api.your-domain.com
LOG_LEVEL=INFO

SECRET_KEY=CHANGE_ME
DATA_ENCRYPTION_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=${{Redis.REDIS_URL}}
CELERY_BROKER_URL=${{Redis.REDIS_URL}}
CELERY_RESULT_BACKEND=${{Redis.REDIS_URL}}
WORKER_EAGER=false

AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=CHANGE_ME
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=90
AI_ALLOW_KEYLESS_SELF_HOSTED=false

SEARCH_PROVIDERS=wikipedia,crossref,openalex
CROSSREF_MAILTO=you@your-domain.com

STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://s3.your-provider.com
STORAGE_REGION=auto
STORAGE_BUCKET=studyforge-generated
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_SIGNED_URL_TTL_SECONDS=900
GENERATED_FILE_RETENTION_DAYS=90

EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@your-domain.com
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true

CORS_ORIGINS=https://app.your-domain.com
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=1000
PDF_RENDERER=platypus
SENTRY_DSN=
