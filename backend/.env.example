# StudyForge AI - backend configuration template
# Copy to backend/.env and fill in real values. NEVER commit the real .env.
#
# Every name below is read by backend/app/config/settings.py. The parity test
# backend/tests/test_env_parity.py fails the build if this file and the Settings
# model ever drift apart again.
#
# Every value marked SECRET must stay server-side; none of them may ever be
# exposed through an EXPO_PUBLIC_* variable or shipped inside the APK/AAB.

# ---------------------------------------------------------------- application
APP_ENV=development                      # development | staging | production
DEBUG=true                               # must be false in production
PUBLIC_APP_URL=http://localhost:8081
PUBLIC_API_URL=http://localhost:8000     # production: https://api.your-domain.com
MOBILE_DEEP_LINK_BASE=ai-notes-maker://
LOG_LEVEL=INFO

# ---------------------------------------------------------------- security (SECRET)
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME
DATA_ENCRYPTION_KEY=CHANGE_ME
ACCESS_TOKEN_MINUTES=15                  # legacy alias: ACCESS_TOKEN_EXPIRE_MINUTES
REFRESH_TOKEN_DAYS=30                    # legacy alias: REFRESH_TOKEN_EXPIRE_DAYS
RESET_TOKEN_MINUTES=30
FAILED_LOGIN_THRESHOLD=5

# ---------------------------------------------------------------- database
DATABASE_URL=postgresql+asyncpg://studyforge:studyforge@localhost:5432/studyforge
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# ---------------------------------------------------------------- queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0   # blank falls back to REDIS_URL
CELERY_RESULT_BACKEND=redis://localhost:6379/1  # blank falls back to REDIS_URL
WORKER_EAGER=false                       # true runs jobs inline (tests only)

# ---------------------------------------------------------------- AI provider (SECRET)
# Administrators configure AI here. Ordinary app users never enter an API key.
AI_PROVIDER=development                  # development | openai | openai-compatible | azure-compatible | ollama | vllm | localai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=CHANGE_ME
AI_MODEL=gpt-4.1-mini
AI_TASK_MODELS={"notes":"gpt-4.1-mini","factcheck":"gpt-4.1","questions":"gpt-4.1-mini"}
AI_FALLBACK_PROVIDER=
AI_TIMEOUT_SECONDS=90

# Approved self-hosted models (Ollama / vLLM / LocalAI).
AI_ALLOW_KEYLESS_SELF_HOSTED=false
AI_SELF_HOSTED_BASE_URL=http://localhost:11434/v1
AI_SELF_HOSTED_MODEL=llama3.1:8b
AI_SELF_HOSTED_ALLOWED_HOSTS=localhost,127.0.0.1,ollama,vllm,localai

# Fair-use protection (not billing - the product is free)
AI_DAILY_TOKEN_LIMIT=200000
AI_MONTHLY_TOKEN_LIMIT=3000000
AI_DAILY_REQUEST_LIMIT=500
AI_MONTHLY_COST_LIMIT=100

# ---------------------------------------------------------------- embeddings
EMBEDDING_PROVIDER=development
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=CHANGE_ME              # SECRET
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536                # changing this requires a vector migration

# ---------------------------------------------------------------- research providers
SEARCH_PROVIDERS=wikipedia,crossref,openalex
TAVILY_API_KEY=                          # SECRET, optional
BRAVE_API_KEY=                           # SECRET, optional
SERPER_API_KEY=                          # SECRET, optional
CROSSREF_MAILTO=you@example.com          # polite-pool contact, not a secret
SEMANTIC_SCHOLAR_API_KEY=                # SECRET, optional
SEARCH_TIMEOUT_SECONDS=20
RESEARCH_MAX_SOURCES=20
RESEARCH_SOURCE_RETENTION_DAYS=30

# ---------------------------------------------------------------- storage (SECRET)
# Canonical names are STORAGE_BACKEND and S3_*. The older STORAGE_PROVIDER /
# STORAGE_BUCKET / STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY / STORAGE_ENDPOINT /
# STORAGE_REGION spellings are still accepted as aliases.
STORAGE_BACKEND=local                    # local | s3 ; production requires s3
STORAGE_PATH=/data/storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
STORAGE_SIGNED_URL_TTL_SECONDS=900
GENERATED_FILE_RETENTION_DAYS=90
PDF_REQUIRE_DURABLE_STORAGE=true

# ---------------------------------------------------------------- email (SECRET)
EMAIL_PROVIDER=development               # development | smtp
EMAIL_FROM=no-reply@your-domain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_TLS=true

# ---------------------------------------------------------------- social sign-in
# Google sign-in is verified server-side against Google's JWKS. The mobile app
# only ever sends an ID token; it never sees GOOGLE_CLIENT_SECRET.
GOOGLE_AUTH_ENABLED=false
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=CHANGE_ME           # SECRET - backend only, never in the app
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_CLOCK_SKEW_SECONDS=120
APPLE_AUTH_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=CHANGE_ME              # SECRET - .p8 contents, backend only

# ---------------------------------------------------------------- uploads & safety
MALWARE_SCANNER=disabled                 # disabled | clamav ; production requires clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MAX_UPLOAD_MB=50
MAX_REQUEST_MB=55
MAX_PDF_PAGES=1000
PDF_RENDERER=platypus
OCR_PROVIDER=tesseract
OCR_LANGUAGES=eng+hin
VISION_PROVIDER=disabled

# ---------------------------------------------------------------- limits & telemetry
CORS_ORIGINS=http://localhost:8081       # never "*" in production
TRUSTED_HOSTS=localhost,127.0.0.1,api
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_FAIL_CLOSED=true
METRICS_ENABLED=true
SENTRY_DSN=
NOTIFICATION_PROVIDER=disabled
